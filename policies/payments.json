{
  "version": "1.0",
  "defaultEffect": "deny",
  "rules": [
    {
      "id": "payment.write.owner",
      "effect": "allow",
      "resourceType": "payment",
      "action": "write",
      "when": {
        "field": "subject.sub",
        "op": "eq",
        "value": "$resource.ownerId"
      }
    },
    {
      "id": "payment.write.support",
      "effect": "allow",
      "resourceType": "payment",
      "action": "write",
      "when": {
        "field": "subject.claims.role",
        "op": "eq",
        "value": "support"
      }
    }
  ]
}
