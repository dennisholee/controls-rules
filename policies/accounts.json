{
  "version": "1.0",
  "defaultEffect": "deny",
  "rules": [
    {
      "id": "deny.sanctioned.subject",
      "effect": "deny",
      "resourceType": "*",
      "action": "*",
      "when": {
        "field": "subject.claims.status",
        "op": "eq",
        "value": "sanctioned"
      }
    },
    {
      "id": "account.read.owner-or-region",
      "effect": "allow",
      "resourceType": "account",
      "action": "read",
      "when": {
        "any": [
          {
            "field": "subject.sub",
            "op": "eq",
            "value": "$resource.ownerId"
          },
          {
            "field": "subject.claims.region",
            "op": "eq",
            "value": "$resource.region"
          }
        ]
      }
    },
    {
      "id": "account.read.agent",
      "effect": "allow",
      "resourceType": "account",
      "action": "read",
      "when": {
        "all": [
          {
            "field": "subject.claims.role",
            "op": "eq",
            "value": "agent"
          },
          {
            "field": "resource.status",
            "op": "eq",
            "value": "active"
          }
        ]
      }
    },
    {
      "id": "account.read.support",
      "effect": "allow",
      "resourceType": "account",
      "action": "read",
      "when": {
        "field": "subject.claims.role",
        "op": "eq",
        "value": "support"
      }
    }
  ]
}
