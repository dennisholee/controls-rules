{
  "version": "1.0",
  "policies": {
    "account.read": {
      "default": "none",
      "fields": {
        "accountNumber": {
          "mode": "partial",
          "keepSuffix": 4
        },
        "holder.email": {
          "mode": "partial",
          "keepPrefix": 1,
          "preserveDomain": true
        },
        "holder.phone": {
          "mode": "partial",
          "keepPrefix": 3,
          "keepSuffix": 2
        },
        "ssn": {
          "mode": "full"
        },
        "dateOfBirth": {
          "mode": "partial",
          "keep": "year"
        }
      },
      "fallback": "classification"
    },
    "account.read.strict": {
      "default": "full",
      "fields": {
        "status": {
          "mode": "none"
        }
      }
    },
    "payment.write": {
      "default": "none",
      "rejectFields": [
        "pan",
        "cvv"
      ],
      "fields": {
        "pan": {
          "mode": "full"
        },
        "cvv": {
          "mode": "full"
        }
      }
    }
  }
}
